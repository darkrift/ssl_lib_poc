module(
    name = "ssl_lib_poc",
    version = "0.0.0",
)

# Hermetic Build's zero-sysroot LLVM toolchains are registered by the root
# module, which gives them precedence over toolchains registered transitively or
# supplied by Bazel's host auto-configuration.
bazel_dep(name = "llvm", version = "0.8.14")

register_toolchains("@llvm//toolchain:all")

# AnalysisTestResultInfo produces a platform-neutral Bazel stub, not a Linux
# binary. Let that stub run on the host execution platform even though all
# compiled targets use the fixed hermetic Linux platform below.
register_toolchains("//toolchains:platform_independent_test_toolchain")

# SSL facade and the implementations exercised by this proof of concept.
# ssl_lib is intentionally absent from the standard BCR and resolves from the
# secondary pinned registry. Mbed TLS is used only by consumers with a native
# Mbed TLS source path, currently curl.
bazel_dep(name = "ssl_lib", version = "1.0.0")
bazel_dep(name = "boringssl", version = "0.20260813.0")
bazel_dep(name = "openssl", version = "4.0.1.bcr.0")
bazel_dep(name = "mbedtls", version = "3.6.7")

# WolfSSL is not available in the standard BCR. AWS-LC provides the split
# :crypto/:ssl targets and the BoringSSL-compatible API used by curl, so use the
# current BCR release as the third implementation.
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.2")

# Used by examples/backend_transitions.bzl to analyze all module examples under
# several SSL facade implementations in the same Bazel invocation. LLVM asks
# for 0.12.0; 1.0.0 has the same compatibility level and is the current release.
bazel_dep(name = "with_cfg.bzl", version = "1.0.0")

# Bazel 9 no longer exposes CcInfo as a global Starlark symbol. The configured
# graph test imports it from rules_cc, so make the already-selected current
# version directly visible to the root module.
bazel_dep(name = "rules_cc", version = "0.2.22")

# Latest versions available from the standard BCR on 2026-08-15.
bazel_dep(name = "asio", version = "1.34.2.bcr.1")

# The PR comment says "awk_sdk"; the BCR module for the AWS SDK is aws_sdk.
bazel_dep(name = "aws_sdk", version = "1.11.758")
bazel_dep(name = "azure-core-cpp", version = "1.14.1.bcr.2")
bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.mysql", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.mqtt5", version = "1.90.0.bcr.1")

# clickhouse-cpp-client was renamed; the old 2.6.2 entry is now yanked.
bazel_dep(name = "clickhouse-cpp", version = "2.6.2")
bazel_dep(name = "curl", version = "8.21.0")
bazel_dep(name = "fastdds", version = "3.4.2.bcr.1")
bazel_dep(name = "ffmpeg", version = "7.1.1.bcr.beta.7")
bazel_dep(name = "folly", version = "2026.05.18.00")
bazel_dep(name = "git", version = "2.55.0")
bazel_dep(name = "grpc", version = "1.83.0")
bazel_dep(name = "libevent", version = "2.1.12-stable.bcr.0")
bazel_dep(name = "libgit2", version = "1.9.2.bcr.1")
bazel_dep(name = "postgres", version = "18.4")
bazel_dep(name = "ppp", version = "2.5.2.bcr.1")
bazel_dep(name = "rsync", version = "3.4.2")

# Extra candidate: librdkafka enables both TLS and curl, making it a useful
# check that all paths converge on the same selected SSL implementation.
bazel_dep(name = "librdkafka", version = "2.15.0")

# Compatibility shims for combining all examples in one root graph. Promote
# the current rules_rust release to the root: Git requests 0.71.3, while
# Protobuf's current crate metadata requires the stricter current implementation.
bazel_dep(name = "rules_rust", version = "0.72.0")

# Protobuf 35.1 is already the current BCR release. Its Rust test crates are
# accidentally non-dev and have no lockfile, which rules_rust correctly rejects
# when Protobuf is transitive. Keep the current release and make only that
# development extension dev-only in a dedicated metadata patch.
bazel_dep(name = "protobuf", version = "35.1")
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//patches:protobuf-rust-dev-dependency.patch"],
    version = "35.1",
)

# gRPC's pinned Envoy API revision imports a retired googleapis extension
# repository. The current revision has completed that migration, so use it as a
# direct root dependency rather than patching the old revision.
bazel_dep(name = "envoy_api", version = "0.0.0-20260130-84e8436")

# gRPC still requests c-ares 1.19.1, whose BUILD file uses the cc_library
# symbol removed from Bazel 9. Promote the current BCR release, whose rules_cc
# loads make it compatible with the Bazel version used by this repository.
bazel_dep(name = "c-ares", version = "1.34.6")

# Folly requests glog 0.7.1, whose macro still calls native.cc_library (removed
# by Bazel 9). The current BCR metadata revision carries the required load.
bazel_dep(name = "glog", version = "0.7.1.bcr.1")

# Folly requests libunwind 1.8.1, whose BUILD file uses the cc_test symbol
# removed from Bazel 9. The current release has explicit rules_cc loads.
bazel_dep(name = "libunwind", version = "1.8.3")

# Folly requests libdwarf 0.12.0.bcr.1, whose test macro calls the removed
# native.cc_test. The current compatible release declares rules_cc explicitly.
bazel_dep(name = "libdwarf", version = "2.2.0.bcr.1")

# double-conversion 3.3.1 is already the newest BCR release but still relies on
# Bazel's removed global C++ rules. Keep that release and add only the explicit
# rules_cc loads required by Bazel 9.
single_version_override(
    module_name = "double-conversion",
    patch_strip = 1,
    patches = ["//patches:double-conversion-bazel9.patch"],
    version = "3.3.1",
)

# lz4 1.10.0 vendors xxHash 0.6.5. Replace its implementation and header with
# the standalone xxhash 0.8.3.bcr.1 module while retaining the transitive link
# interface required by lz4_frame and the CLI. Rsync's direct dependency then
# resolves to the same configured xxhash library instead of a duplicate copy.
single_version_override(
    module_name = "lz4",
    patch_strip = 1,
    patches = ["//patches:lz4-no-bundled-xxhash.patch"],
    version = "1.10.0.bcr.1",
)

# FastDDS's current foonathan_memory release builds a code generator in the
# target configuration, then tries to run the cross-compiled Linux executable.
# Mark it as a genrule tool so Bazel uses the hermetic LLVM exec toolchain.
single_version_override(
    module_name = "foonathan_memory",
    patch_strip = 1,
    patches = ["//patches:foonathan-memory-exec-tool.patch"],
    version = "0.7.3.bcr.2",
)

single_version_override(
    module_name = "asio",
    patch_strip = 1,
    patches = ["//patches:asio.patch"],
    version = "1.34.2.bcr.1",
)

single_version_override(
    module_name = "aws_sdk",
    patch_strip = 1,
    patches = ["//patches:aws_sdk.patch"],
