diff --git a/curl_transition.bzl b/curl_transition.bzl
new file mode 100644
index 0000000..0508788
--- /dev/null
+++ b/curl_transition.bzl
@@ -0,0 +1,14 @@
+"""A dependency-edge transition for curl's native Mbed TLS backend."""
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@with_cfg.bzl", "with_cfg")
+
+_builder = with_cfg(cc_library)
+
+# Mbed TLS has its own API and one monolithic BCR target. Select curl's native
+# source mode and keep both ssl_lib facade labels congruent within this subtree.
+_builder.set(Label("@curl//:ssl_lib"), "mbedtls")
+_builder.set(Label("@ssl_lib//:crypto"), Label("@mbedtls//:mbedtls"))
+_builder.set(Label("@ssl_lib//:ssl"), Label("@mbedtls//:mbedtls"))
+
+curl_mbedtls_cc_library, _curl_mbedtls_cc_library_internal = _builder.build()
